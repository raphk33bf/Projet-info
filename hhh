def un_debut_gps(self, instance):
    """
    Fonction permettant le début d’un enregistrement gps sans limite de temps fixe
    """
    self.attente_gps = Label(text = "En attente des positions GPS")
    self.layout.add_widget(self.attente_gps)
    gps.configure(on_location=self.recup_donnees_gps)
    gps.start()
    self.timestamp_debut = time()

def un_fin_gps(self, instance):
    """
    Fonction permettant la fin d’un enregistrement gps sans limite de temps fixe.
    Doit permettre d’afficher les sous-transports et de comparer avec les estimations.
    """
    gps.stop()
    self.layout.clear_widgets()
    self.titre = Label(text = "Voilà les moyens de transport que vous avez utilisés")
    self.layout.add_widget(self.titre)
    self.timestamp_fin = time()
    data = {'timestamp_debut': self.timestamp_debut, 'timestamp_fin': self.timestamp_fin}
    headers = {'Content-Type': 'application/json'}
    urlRequest(url='https://ciorso.free.fr/Ambraspbind/deter_un_moyen.php', req_body=json.dumps(data))

def un_get_result(self, requete, resultat):
    self.un_moyen_donne = Label(text="Quels moyens de transport avez-vous utilisé ?")
    self.layout.add_widget(self.un_moyen_donne)
    self.un_moyen_input = TextInput(hint_text="Moyen 1")
    self.layout.add_widget(self.un_moyen_input)
    self.button = Button(text="Entrer", on_press=self.un_envoi_moy)
    self.layout.add_widget(self.button)
    self.un_moyen_estime=resultat

def un_envoi_moy(self, instance):
    self.layout.clear_widgets()
    self.label=Label(text="Vous avez estimé que vous avez utilisé le [n] moyen de transport suivant :")
    self.layout.add_widget(self.label)
    self.label=Label(text=self.un_moyen_estime)
    self.layout.add_widget(self.label)
    self.label=Label(text="Vous avez déclaré avoir utilisé le moyen suivant : [n]")
    self.layout.add_widget(self.label)
    self.label=Label(text=self.un_moyen_input.text)
    self.layout.add_widget(self.label)
